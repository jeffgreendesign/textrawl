# Textrawl dashboard environment variables (Next.js — only NEXT_PUBLIC_* reach the browser).

# Base URL of the Textrawl server REST API. Falls back to http://localhost:3000/api.
# At deploy time, set this to your server origin (e.g. https://api.example.com/api).
NEXT_PUBLIC_API_URL=http://localhost:3000/api

# Optional explicit WebSocket URL. If unset, it is derived from NEXT_PUBLIC_API_URL.
# NEXT_PUBLIC_WS_URL=wss://api.example.com/ws

# Upload switch point (MB): files at or below this size use the direct single-shot
# POST; larger files use the resumable GCS flow. Defaults to 20, matching the
# server's MAX_SINGLE_FILE_SIZE_MB.
NEXT_PUBLIC_UPLOAD_THRESHOLD_MB=20
