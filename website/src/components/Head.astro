---
import type { Props } from '@astrojs/starlight/props';
import Default from '@astrojs/starlight/components/Head.astro';
---

<Default {...Astro.props} />

<!-- Favicon -->
<link rel="icon" type="image/svg+xml" href="/favicon.svg" />
<link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
<link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
<link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
<link rel="manifest" href="/site.webmanifest" />

<!-- llms.txt discovery -->
<link rel="llms" href="/llms.txt" />

<!-- MCP capability advertisement -->
<link rel="mcp" href="/.well-known/mcp.json" />

<!-- Open Graph -->
<meta property="og:title" content={Astro.props.entry?.data.title || 'Textrawl'} />
<meta property="og:description" content="Personal Knowledge MCP Server - Turn your documents into Claude's memory" />
<meta property="og:type" content="website" />
<meta property="og:image" content="/og-image.png" />

<!-- Twitter Card -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:title" content={Astro.props.entry?.data.title || 'Textrawl'} />
<meta name="twitter:description" content="Personal Knowledge MCP Server - Turn your documents into Claude's memory" />
<meta name="twitter:image" content="/og-image.png" />

<!-- Schema.org JSON-LD -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "name": "Textrawl",
  "applicationCategory": "DeveloperApplication",
  "operatingSystem": "Cross-platform",
  "description": "Personal Knowledge MCP Server - Hybrid semantic + full-text search over documents for Claude",
  "url": "https://textrawl.dev",
  "author": {
    "@type": "Organization",
    "name": "Textrawl"
  },
  "offers": {
    "@type": "Offer",
    "price": "0",
    "priceCurrency": "USD"
  }
})} />
