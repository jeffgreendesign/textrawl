{
	"$schema": "https://biomejs.dev/schemas/2.5.3/schema.json",
	"assist": { "actions": { "source": { "organizeImports": "on" } } },
	"linter": {
		"enabled": true,
		"rules": {
			"preset": "recommended",
			"style": {
				"useNumberNamespace": "off",
				"noNonNullAssertion": "warn"
			},
			"complexity": {
				"noForEach": "warn",
				"noImportantStyles": "off"
			},
			"suspicious": {
				"noExplicitAny": "warn",
				"noArrayIndexKey": "warn"
			},
			"a11y": {
				"useButtonType": "warn",
				"noStaticElementInteractions": "warn",
				"noAmbiguousAnchorText": "warn",
				"noSvgWithoutTitle": "warn"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"trailingCommas": "all"
		}
	},
	"files": {
		"includes": [
			"**",
			"!**/node_modules",
			"!**/.next",
			"!**/.source",
			"!**/dist",
			"!**/.vercel",
			"!**/*.min.js",
			"!**/*.d.ts",
			"!**/.claude",
			"!**/public",
			"!**/__tests__/fixtures"
		]
	},
	"overrides": [
		{
			"includes": ["**/desktop/**", "**/scripts/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off",
						"noMisleadingCharacterClass": "off"
					},
					"style": {
						"noNonNullAssertion": "off"
					},
					"complexity": {
						"noForEach": "off"
					},
					"a11y": {
						"useSemanticElements": "off"
					},
					"correctness": {
						"useExhaustiveDependencies": "warn"
					}
				}
			}
		}
	]
}
