{
	"$schema": "https://biomejs.dev/schemas/1.9.4/schema.json",
	"organizeImports": {
		"enabled": true
	},
	"linter": {
		"enabled": true,
		"rules": {
			"recommended": true,
			"style": {
				"useNumberNamespace": "off",
				"noNonNullAssertion": "warn"
			},
			"complexity": {
				"noForEach": "warn"
			},
			"suspicious": {
				"noExplicitAny": "warn"
			}
		}
	},
	"formatter": {
		"enabled": true,
		"indentStyle": "tab",
		"lineWidth": 100
	},
	"javascript": {
		"formatter": {
			"quoteStyle": "single",
			"trailingCommas": "all"
		}
	},
	"files": {
		"ignore": [
			"node_modules",
			".next",
			".source",
			"dist",
			".vercel",
			"*.min.js",
			"*.d.ts",
			".claude"
		]
	},
	"overrides": [
		{
			"include": ["desktop/**", "scripts/**"],
			"linter": {
				"rules": {
					"suspicious": {
						"noExplicitAny": "off",
						"noMisleadingCharacterClass": "off"
					},
					"style": {
						"noNonNullAssertion": "off"
					},
					"complexity": {
						"noForEach": "off"
					},
					"a11y": {
						"useSemanticElements": "off"
					},
					"correctness": {
						"useExhaustiveDependencies": "warn"
					}
				}
			}
		}
	]
}
