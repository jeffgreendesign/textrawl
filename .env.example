# Textrawl Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# CORS (comma-separated origins)
# Leave empty or omit to disable cross-origin requests (recommended for security)
# Example: ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=

# Authentication (generate with: openssl rand -hex 32)
API_BEARER_TOKEN=your-64-character-hex-token-here

# Database (Neon PostgreSQL)
# Pooled connection (runtime queries via PgBouncer)
DATABASE_URL=postgres://user:password@endpoint-pooler.region.aws.neon.tech/dbname?sslmode=require
# Direct connection (migrations, schema changes - optional)
# DATABASE_URL_UNPOOLED=postgres://user:password@endpoint.region.aws.neon.tech/dbname?sslmode=require

# Embedding Provider: "openai", "ollama", or "google"
EMBEDDING_PROVIDER=openai

# OpenAI (required if EMBEDDING_PROVIDER=openai)
# Get from: platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# Ollama (required if EMBEDDING_PROVIDER=ollama)
# Install: https://ollama.com/download
# Supported models and their database schemas:
#   nomic-embed-text (1024d)      - ollama pull nomic-embed-text     → setup-db-ollama.sql
#   nomic-embed-text-v2-moe (768d) - ollama pull nomic-embed-text-v2-moe → setup-db-ollama-v2.sql
#   mxbai-embed-large (1024d)     - ollama pull mxbai-embed-large   → setup-db-ollama.sql
# Note: nomic-embed-text-v2-moe is recommended for new installations (better performance, multilingual)
# Default stays v1 for backward compatibility with existing databases
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text

# Google AI (required if EMBEDDING_PROVIDER=google)
# Get from: https://aistudio.google.com/app/apikey
# Model: gemini-embedding-2 at 1536 dimensions (requested via outputDimensionality;
#        the model is natively 3072d, above pgvector's 2000-dim HNSW limit) → setup-db-google.sql
# GOOGLE_AI_API_KEY=your-google-ai-api-key
# GOOGLE_EMBEDDING_MODEL=gemini-embedding-2

# OAuth (optional - enables OAuth 2.0 for Claude/ChatGPT mobile apps)
# All four required vars must be set together to enable OAuth. Bearer token auth still works alongside.
# Create credentials at: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
# OAUTH_JWT_SECRET=your-64-char-hex-generate-with-openssl-rand-hex-32
# OAUTH_ALLOWED_EMAILS=you@gmail.com
# OAUTH_SERVER_URL=https://your-instance.run.app

# Feature Flags
# Set to "false" to disable persistent memory tools
ENABLE_MEMORY=true

# Conversation Memory (Phase 2)
# Set to "false" to disable conversation memory tools
ENABLE_CONVERSATIONS=true

# Proactive Insights
# Set to "false" to disable insight discovery tools
ENABLE_INSIGHTS=true

# Memory Extraction (Phase 3)
# Requires Anthropic API key for LLM-based entity/fact extraction
# Set to "true" to enable extract_memories tool and extractMemories parameter in add_note
ENABLE_MEMORY_EXTRACTION=false

# Anthropic API (required if ENABLE_MEMORY_EXTRACTION=true)
# Get from: console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Extraction Model (fast, cheap model recommended)
# Options: claude-haiku-4-5-20251001, claude-sonnet-4-6, etc.
EXTRACTION_MODEL=claude-haiku-4-5-20251001

# Insight Model (used for insight synthesis, benefits from capable reasoning)
# INSIGHT_MODEL=claude-sonnet-4-6

# Response Format
# true: Compact responses (40-60% fewer tokens, short keys like "n", "t", "o")
# false: Verbose responses (human-readable keys like "name", "type", "observations")
# Default: true (recommended for production to reduce LLM context usage)
COMPACT_RESPONSES=true

# Chunking Strategy
# fixed: Paragraph-aware splitting at ~512 tokens (fast, default)
# semantic: Embedding-based splitting at topic boundaries (better retrieval accuracy)
# Note: Semantic chunking requires extra embedding API calls during document upload
CHUNKING_MODE=fixed

# Semantic Chunking Threshold (0-1, only used when CHUNKING_MODE=semantic)
# Lower = more chunks (0.4 = sensitive to topic shifts)
# Higher = fewer chunks (0.6 = only major topic changes)
# Recommended: 0.5
SEMANTIC_SIMILARITY_THRESHOLD=0.5

# Ingest / search performance (optional)
# Concurrent provider batches within one embedding call (speeds up semantic
# chunking and large embeds). Peak concurrent provider requests during ingest is
# roughly EMBED_WINDOW_CONCURRENCY * EMBEDDING_BATCH_CONCURRENCY; retries absorb 429s.
# EMBEDDING_BATCH_CONCURRENCY=2
# Concurrent 128-chunk embed+insert windows (overlaps embed and insert for large
# documents). Higher values raise peak memory. Default 2.
# EMBED_WINDOW_CONCURRENCY=2
# pgvector HNSW ef_search: candidate list size, higher = better recall at some
# latency cost. pgvector's built-in default is 40. Requires pgvector for effect.
# HNSW_EF_SEARCH=100

# Redis (optional - enables shared rate limiting across multiple instances)
# When set, rate limiters use Redis instead of in-memory counters.
# Required for accurate rate limiting in multi-instance deployments (Cloud Run, K8s).
# Falls back to in-memory if the connection fails at startup.
# REDIS_URL=redis://localhost:6379

# Insight Tuning
# INSIGHT_BATCH_THRESHOLD=50     # Chunks inserted before scan is eligible
# INSIGHT_DEBOUNCE_SECONDS=300   # Wait this long after last insert before scanning

# Postgres Analysis (optional - enables pg_analyze, pg_recommendations, pg_report_history tools)
# PG_REPORT_DIR=./reports/pg-analysis

# File Size Limits
# MAX_SINGLE_FILE_SIZE_MB=20     # Max file size for upload (MB)
# WARN_FILE_SIZE_MB=5            # Log a warning when a document exceeds this size (MB)
# MAX_CHUNKS_PER_FILE=500        # Soft threshold: log large files above ~N chunks (advisory)
# MAX_CHUNKS_HARD_CAP=50000      # Hard cap: reject a document producing >N chunks (backstop)

# Large Uploads (GCS resumable + Cloud Tasks workflow)
# MAX_UPLOAD_SIZE_MB=500         # Max size accepted by /api/upload/init resumable path
# UPLOAD_THRESHOLD_MB=20         # Direct (<=) vs resumable (>) switch point; defaults to MAX_SINGLE_FILE_SIZE_MB
# UPLOAD_SESSION_TTL_MIN=120     # Resumable session + upload-row expiry (minutes)
# GCS_UPLOAD_BUCKET=             # GCS bucket for large uploads (required once GCS storage is enabled)
# GCS_PROJECT_ID=               # GCP project id; optional, auto-detected from ADC/SA key if unset

# Async upload processing (Cloud Tasks). Set queue + process URL together to use
# the real Cloud Tasks queue instead of the in-memory fake.
# CLOUD_TASKS_QUEUE=textrawl-upload-processing   # Queue id
# CLOUD_TASKS_LOCATION=us-east4                   # Queue region (default: us-central1)
# CLOUD_TASKS_SERVICE_ACCOUNT=                    # OIDC identity minted into each task
# UPLOAD_PROCESS_URL=                             # Internal endpoint base (target <url>/<uploadId> + OIDC audience)

# Safe-ZIP extraction limits (enforced against the central directory before
# decompressing; archive-level violations fail the whole upload).
# ZIP_MAX_ENTRIES=2000                # Max file entries per archive
# ZIP_MAX_COMPRESSED_BYTES=           # Max compressed archive size (bytes); defaults to MAX_UPLOAD_SIZE_MB
# ZIP_MAX_EXPANDED_BYTES=2000000000   # Max total uncompressed size (bytes) — bomb guard
# ZIP_MAX_ENTRY_BYTES=50000000        # Max uncompressed size of a single entry (bytes)
# ZIP_MAX_COMPRESSION_RATIO=100       # Max expanded/compressed ratio — bomb guard
# ZIP_MAX_FILENAME_LEN=255            # Max entry-path length (characters)
