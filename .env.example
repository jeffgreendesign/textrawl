# Textrawl Configuration
# Copy this file to .env and fill in your values

# Server
PORT=3000
NODE_ENV=development
LOG_LEVEL=info

# CORS (comma-separated origins)
# Leave empty or omit to disable cross-origin requests (recommended for security)
# Example: ALLOWED_ORIGINS=https://app.example.com,https://admin.example.com
ALLOWED_ORIGINS=

# Authentication (generate with: openssl rand -hex 32)
API_BEARER_TOKEN=your-64-character-hex-token-here

# Supabase (get from: supabase.com > Project Settings > API)
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key

# Embedding Provider: "openai" or "ollama"
EMBEDDING_PROVIDER=openai

# OpenAI (required if EMBEDDING_PROVIDER=openai)
# Get from: platform.openai.com/api-keys
OPENAI_API_KEY=sk-your-openai-api-key

# Ollama (required if EMBEDDING_PROVIDER=ollama)
# Install: https://ollama.com/download
# Supported models and their database schemas:
#   nomic-embed-text (1024d)      - ollama pull nomic-embed-text     → setup-db-ollama.sql
#   nomic-embed-text-v2-moe (768d) - ollama pull nomic-embed-text-v2-moe → setup-db-ollama-v2.sql
#   mxbai-embed-large (1024d)     - ollama pull mxbai-embed-large   → setup-db-ollama.sql
# Note: nomic-embed-text-v2-moe is recommended for new installations (better performance, multilingual)
# Default stays v1 for backward compatibility with existing databases
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=nomic-embed-text

# OAuth (optional - enables OAuth 2.0 for Claude/ChatGPT mobile apps)
# All four required vars must be set together to enable OAuth. Bearer token auth still works alongside.
# Create credentials at: https://console.cloud.google.com/apis/credentials
# GOOGLE_CLIENT_ID=your-client-id.apps.googleusercontent.com
# GOOGLE_CLIENT_SECRET=GOCSPX-your-secret
# OAUTH_JWT_SECRET=your-64-char-hex-generate-with-openssl-rand-hex-32
# OAUTH_ALLOWED_EMAILS=you@gmail.com
# OAUTH_SERVER_URL=https://your-instance.run.app

# Feature Flags
# Set to "false" to disable persistent memory tools
ENABLE_MEMORY=true

# Conversation Memory (Phase 2)
# Set to "false" to disable conversation memory tools
ENABLE_CONVERSATIONS=true

# Memory Extraction (Phase 3)
# Requires Anthropic API key for LLM-based entity/fact extraction
# Set to "true" to enable extract_memories tool and extractMemories parameter in add_note
ENABLE_MEMORY_EXTRACTION=false

# Anthropic API (required if ENABLE_MEMORY_EXTRACTION=true)
# Get from: console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-your-anthropic-api-key

# Extraction Model (fast, cheap model recommended)
# Options: claude-3-haiku-20240307, claude-3-5-sonnet-20241022, etc.
EXTRACTION_MODEL=claude-3-haiku-20240307

# Response Format
# true: Compact responses (40-60% fewer tokens, short keys like "n", "t", "o")
# false: Verbose responses (human-readable keys like "name", "type", "observations")
# Default: true (recommended for production to reduce LLM context usage)
COMPACT_RESPONSES=true

# Chunking Strategy
# fixed: Paragraph-aware splitting at ~512 tokens (fast, default)
# semantic: Embedding-based splitting at topic boundaries (better retrieval accuracy)
# Note: Semantic chunking requires extra embedding API calls during document upload
CHUNKING_MODE=fixed

# Semantic Chunking Threshold (0-1, only used when CHUNKING_MODE=semantic)
# Lower = more chunks (0.4 = sensitive to topic shifts)
# Higher = fewer chunks (0.6 = only major topic changes)
# Recommended: 0.5
SEMANTIC_SIMILARITY_THRESHOLD=0.5
