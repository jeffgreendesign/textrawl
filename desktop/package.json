{
	"name": "textrawl-desktop",
	"version": "0.1.0",
	"description": "Textrawl Desktop - Convert files to searchable markdown",
	"author": "Textrawl",
	"license": "MIT",
	"main": "dist/main/index.js",
	"scripts": {
		"preinstall": "npx only-allow pnpm",
		"dev": "pnpm run build && env -u ELECTRON_RUN_AS_NODE electron .",
		"dev:verbose": "pnpm run build && env -u ELECTRON_RUN_AS_NODE electron . --verbose",
		"dev:vite": "vite",
		"build": "pnpm run build:main && pnpm run build:preload && pnpm run build:renderer",
		"build:main": "esbuild src/main/index.ts --bundle --platform=node --target=node20 --outfile=dist/main/index.js --format=cjs --external:electron --external:electron-store --external:pdf-parse --external:mammoth --external:xlsx --external:csv-parse --external:rtf-parser --external:unzipper --external:gray-matter --external:fast-xml-parser --external:chokidar",
		"build:preload": "esbuild src/preload/index.ts --bundle --platform=node --target=node20 --outfile=dist/preload/index.js --format=cjs --packages=external",
		"build:renderer": "vite build",
		"start": "env -u ELECTRON_RUN_AS_NODE electron .",
		"pack": "pnpm run build && env -u ELECTRON_RUN_AS_NODE electron-builder --dir",
		"dist": "pnpm run build && env -u ELECTRON_RUN_AS_NODE electron-builder",
		"dist:mac": "pnpm run build && env -u ELECTRON_RUN_AS_NODE electron-builder --mac --x64",
		"typecheck": "tsc --noEmit -p tsconfig.main.json && tsc --noEmit -p tsconfig.preload.json"
	},
	"dependencies": {
		"csv-parse": "^5.5.6",
		"electron-store": "^8.2.0",
		"fast-xml-parser": "^5.3.4",
		"gray-matter": "^4.0.3",
		"mammoth": "^1.8.0",
		"p-limit": "^5.0.0",
		"pdf-parse": "^1.1.1",
		"rtf-parser": "^1.3.3",
		"unzipper": "^0.12.3",
		"chokidar": "^5.0.0",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
	},
	"devDependencies": {
		"electron": "^44.3.0",
		"@preact/preset-vite": "^2.10.6",
		"@types/node": "^26.5.1",
		"@types/unzipper": "^0.10.11",
		"electron-builder": "^26.15.3",
		"esbuild": "^0.28.2",
		"preact": "^10.29.8",
		"typescript": "^7.0.2",
		"vite": "^8.3.0"
	},
	"build": {
		"extends": "./electron-builder.yml"
	},
	"engines": {
		"node": ">=22.0.0"
	}
}
