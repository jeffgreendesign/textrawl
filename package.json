{
	"name": "textrawl",
	"version": "0.4.0",
	"description": "Personal knowledge server - semantic search, persistent memory, and proactive insights for your documents",
	"type": "module",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"dev": "tsx watch --env-file=.env src/index.ts",
		"build": "tsc && node esbuild.config.mjs",
		"start": "node dist/index.js",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"lint:md": "markdownlint-cli2",
		"lint:md:fix": "markdownlint-cli2 --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"quality": "pnpm lint && pnpm lint:md && pnpm typecheck",
		"verify:fast": "pnpm quality && pnpm test && ./scripts/security-check.sh && ./scripts/docs-check.sh && ./scripts/tool-sync-check.sh",
		"verify": "pnpm quality && pnpm test && ./scripts/security-check.sh && ./scripts/tool-sync-check.sh && pnpm build && pnpm docs:build",
		"security-check": "./scripts/security-check.sh",
		"tool-sync": "./scripts/tool-sync-check.sh",
		"preinstall": "npx only-allow pnpm",
		"prepare": "husky",
		"inspector": "npx @modelcontextprotocol/inspector http://localhost:3000/mcp",
		"setup": "bash scripts/setup.sh",
		"convert": "tsx scripts/cli/convert.ts",
		"convert:mbox": "tsx scripts/cli/converters/mbox.ts",
		"convert:eml": "tsx scripts/cli/converters/eml.ts",
		"convert:takeout": "tsx scripts/cli/converters/takeout.ts",
		"convert:html": "tsx scripts/cli/converters/html.ts",
		"upload": "tsx scripts/cli/upload.ts",
		"scan": "tsx scripts/cli/scan.ts",
		"split": "tsx scripts/cli/split.ts",
		"probe:cors": "tsx scripts/cli/probe-resumable-cors.ts",
		"ui": "tsx scripts/ui/server.ts",
		"docs:dev": "pnpm --filter textrawl-website dev",
		"docs:build": "pnpm --filter textrawl-website build",
		"desktop:dev": "pnpm --filter textrawl-desktop dev",
		"desktop:build": "pnpm --filter textrawl-desktop build",
		"desktop:dist": "pnpm --filter textrawl-desktop dist",
		"generate:favicons": "node scripts/generate-favicons.js",
		"pg:analyze": "tsx scripts/cli/pg-analyze.ts",
		"insights:backfill": "tsx scripts/cli/backfill-insights.ts"
	},
	"packageManager": "pnpm@9.15.0",
	"dependencies": {
		"@anthropic-ai/sdk": "^0.131.0",
		"@google-cloud/storage": "^7.21.0",
		"@google-cloud/tasks": "^6.3.0",
		"@google/genai": "^2.26.0",
		"@modelcontextprotocol/ext-apps": "^1.7.5",
		"@modelcontextprotocol/sdk": "^1.31.0",
		"@neondatabase/serverless": "^1.2.0",
		"cors": "^2.8.5",
		"dotenv": "^18.0.5",
		"express": "^5.0.0",
		"express-rate-limit": "^8.7.0",
		"file-type": "^22.1.1",
		"google-auth-library": "^11.1.0",
		"helmet": "^8.3.0",
		"html-to-text": "^10.0.1",
		"jose": "^6.2.12",
		"jsdom": "^30.1.1",
		"mammoth": "^1.13.0",
		"multer": "^2.4.0",
		"openai": "^7.27.0",
		"rate-limit-redis": "^6.0.1",
		"redis": "^6.3.0",
		"turndown": "^7.2.2",
		"unpdf": "^1.8.1",
		"unzipper": "^0.12.5",
		"ws": "^8.22.0",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
		"zod": "^4.6.5"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.15",
		"@types/cli-progress": "^3.11.0",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.0",
		"@types/html-to-text": "^9.0.4",
		"@types/jsdom": "^30.0.0",
		"@types/mailparser": "^3.9.0",
		"@types/multer": "^2.3.0",
		"@types/node": "^26.1.2",
		"@types/pg": "^8.23.1",
		"@types/sanitize-html": "^2.16.2",
		"@types/supertest": "^7.2.1",
		"@types/turndown": "^5.0.0",
		"@types/ws": "^8.18.2",
		"cli-progress": "^3.12.0",
		"commander": "^15.0.0",
		"esbuild": "^0.28.2",
		"glob": "^13.0.6",
		"gray-matter": "^4.0.3",
		"husky": "^9.1.0",
		"ical.js": "^2.0.0",
		"mailparser": "^3.9.33",
		"markdownlint-cli2": "^0.23.3",
		"node-mbox": "^2.0.0",
		"p-limit": "^7.3.1",
		"sanitize-html": "^2.18.0",
		"sharp": "^0.35.5",
		"supertest": "^7.3.0",
		"tsx": "^4.23.15",
		"turndown-plugin-gfm": "^1.0.2",
		"typescript": "^7.0.2",
		"vitest": "^4.1.10"
	},
	"pnpm": {
		"overrides": {
			"hono": "^4.12.33",
			"tar": ">=7.5.22",
			"body-parser": ">=2.3.0",
			"@isaacs/brace-expansion": ">=5.0.1",
			"postcss@<8.5.10": ">=8.5.10",
			"@tootallnate/once@<3.0.1": ">=3.0.1",
			"tmp@<0.2.6": ">=0.2.6",
			"qs@>=6.11.1 <=6.15.1": ">=6.15.2",
			"uuid": ">=11.1.1"
		}
	},
	"keywords": [
		"mcp",
		"rag",
		"knowledge-base",
		"semantic-search",
		"claude"
	],
	"author": "Jeff",
	"license": "MIT"
}
