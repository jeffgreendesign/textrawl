{
	"name": "textrawl",
	"version": "0.3.0",
	"description": "Personal knowledge server - semantic search, persistent memory, and proactive insights for your documents",
	"type": "module",
	"engines": {
		"node": ">=22.0.0"
	},
	"scripts": {
		"dev": "tsx watch --env-file=.env src/index.ts",
		"build": "tsc && node esbuild.config.mjs",
		"start": "node dist/index.js",
		"typecheck": "tsc --noEmit",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"lint:md": "markdownlint-cli2",
		"lint:md:fix": "markdownlint-cli2 --fix",
		"test": "vitest run",
		"test:watch": "vitest",
		"quality": "pnpm lint && pnpm lint:md && pnpm typecheck",
		"verify:fast": "pnpm quality && pnpm test && ./scripts/security-check.sh && ./scripts/docs-check.sh && ./scripts/tool-sync-check.sh",
		"verify": "pnpm quality && pnpm test && ./scripts/security-check.sh && ./scripts/tool-sync-check.sh && pnpm build && pnpm docs:build",
		"security-check": "./scripts/security-check.sh",
		"tool-sync": "./scripts/tool-sync-check.sh",
		"preinstall": "npx only-allow pnpm",
		"prepare": "husky",
		"inspector": "npx @modelcontextprotocol/inspector http://localhost:3000/mcp",
		"setup": "bash scripts/setup.sh",
		"convert": "tsx scripts/cli/convert.ts",
		"convert:mbox": "tsx scripts/cli/converters/mbox.ts",
		"convert:eml": "tsx scripts/cli/converters/eml.ts",
		"convert:takeout": "tsx scripts/cli/converters/takeout.ts",
		"convert:html": "tsx scripts/cli/converters/html.ts",
		"upload": "tsx scripts/cli/upload.ts",
		"scan": "tsx scripts/cli/scan.ts",
		"split": "tsx scripts/cli/split.ts",
		"ui": "tsx scripts/ui/server.ts",
		"docs:dev": "pnpm --filter textrawl-website dev",
		"docs:build": "pnpm --filter textrawl-website build",
		"desktop:dev": "pnpm --filter textrawl-desktop dev",
		"desktop:build": "pnpm --filter textrawl-desktop build",
		"desktop:dist": "pnpm --filter textrawl-desktop dist",
		"generate:favicons": "node scripts/generate-favicons.js",
		"pg:analyze": "tsx scripts/cli/pg-analyze.ts"
	},
	"packageManager": "pnpm@9.15.0",
	"dependencies": {
		"@anthropic-ai/sdk": "^0.71.2",
		"@google/generative-ai": "^0.24.1",
		"@modelcontextprotocol/ext-apps": "^1.0.0",
		"@modelcontextprotocol/sdk": "^1.26.0",
		"@neondatabase/serverless": "^1.0.2",
		"cors": "^2.8.5",
		"dotenv": "^17.2.3",
		"express": "^5.0.0",
		"express-rate-limit": "^7.4.0",
		"file-type": "^21.2.0",
		"helmet": "^8.1.0",
		"hono": "^4.11.7",
		"jose": "^6.1.3",
		"jsdom": "^29.0.1",
		"mammoth": "^1.8.0",
		"multer": "^2.0.2",
		"openai": "^4.70.0",
		"pdf-parse": "^1.1.1",
		"rate-limit-redis": "^4.3.1",
		"redis": "^5.10.0",
		"turndown": "^7.2.2",
		"ws": "^8.20.0",
		"xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
		"zod": "^3.23.0"
	},
	"devDependencies": {
		"@biomejs/biome": "1.9.4",
		"@types/cli-progress": "^3.11.0",
		"@types/cors": "^2.8.19",
		"@types/express": "^5.0.0",
		"@types/jsdom": "^21.0.0",
		"@types/mailparser": "^3.4.0",
		"@types/multer": "^1.4.12",
		"@types/node": "^22.0.0",
		"@types/pg": "^8.18.0",
		"@types/sanitize-html": "^2.13.0",
		"@types/turndown": "^5.0.0",
		"@types/ws": "^8.18.1",
		"cli-progress": "^3.12.0",
		"commander": "^12.0.0",
		"esbuild": "^0.27.2",
		"glob": "^10.3.0",
		"gray-matter": "^4.0.3",
		"husky": "^9.1.0",
		"ical.js": "^2.0.0",
		"mailparser": "^3.6.0",
		"markdownlint-cli2": "^0.20.0",
		"node-mbox": "^2.0.0",
		"p-limit": "^5.0.0",
		"sanitize-html": "^2.12.0",
		"sharp": "^0.34.5",
		"tsx": "^4.19.0",
		"turndown-plugin-gfm": "^1.0.2",
		"typescript": "^5.7.0",
		"unzipper": "^0.12.0",
		"vitest": "^4.0.18"
	},
	"pnpm": {
		"overrides": {
			"hono": "^4.11.7",
			"tar": ">=7.5.7",
			"@isaacs/brace-expansion": ">=5.0.1",
			"postcss@<8.5.10": ">=8.5.10",
			"@tootallnate/once@<3.0.1": ">=3.0.1"
		}
	},
	"keywords": ["mcp", "rag", "knowledge-base", "semantic-search", "claude"],
	"author": "Jeff",
	"license": "MIT"
}
